{
  "format": 1,
  "id": "test/nested-group",
  "version": "1.0.0",
  "title": "Hires pass, from a node group",
  "description": "Holds a test/hires instance as node 5, passing its ports and two of its settings through.",
  "inputs": [
    { "name": "model", "type": "MODEL", "to": [{ "nodeId": "5", "input": "model" }] },
    { "name": "positive", "type": "CONDITIONING", "to": [{ "nodeId": "5", "input": "positive" }] },
    { "name": "negative", "type": "CONDITIONING", "to": [{ "nodeId": "5", "input": "negative" }] },
    { "name": "samples", "type": "LATENT", "to": [{ "nodeId": "5", "input": "samples" }] }
  ],
  "outputs": [
    { "name": "latent", "type": "LATENT", "from": { "nodeId": "5", "output": 0 } }
  ],
  "settings": [
    { "name": "denoise", "kind": "float", "default": 0.45, "min": 0, "max": 1,
      "to": [{ "nodeId": "5", "input": "denoise" }] },
    { "name": "seed", "kind": "seed", "default": 0,
      "to": [{ "nodeId": "5", "input": "seed" }] }
  ],
  "requires": {
    "classes": {
      "LatentUpscaleBy": "sha256:a149764f119e4f3dee5003e1",
      "KSampler": "sha256:9bb8dab51fdefa092f7d92e5"
    },
    "packs": {},
    "models": {}
  },
  "uses": {
    "test/hires": { "version": "1.0.0", "digest": "sha256:54498c0e4e7d1245fb36527db1726a408e008c9ce95135ca5325838b9233d657" }
  }
}
