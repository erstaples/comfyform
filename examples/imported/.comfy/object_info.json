      "strength_model": ["FLOAT", {"default": 1.0, "min": -100.0, "max": 100.0, "step": 0.01}],
      "strength_clip": ["FLOAT", {"default": 1.0, "min": -100.0, "max": 100.0, "step": 0.01}]
    }},
    "input_order": {"required": ["model", "clip", "lora_name", "strength_model", "strength_clip"]},
    "output": ["MODEL", "CLIP"], "output_is_list": [false, false], "output_name": ["MODEL", "CLIP"],
    "name": "LoraLoader", "display_name": "Load LoRA", "category": "loaders", "output_node": false, "python_module": "nodes"
  },
  "CLIPTextEncode": {
    "input": {"required": {"text": ["STRING", {"multiline": true, "dynamicPrompts": true}], "clip": ["CLIP"]}},
    "input_order": {"required": ["text", "clip"]},
